# Cloudflare Pages headers: member web (https://woori.stream).
# `pnpm pages:web` fills {{API_ORIGIN}} / {{R2_ORIGIN}} (presigned uploads)
# from the Pages build environment and adds each page's
# inline-script hashes as a <meta> CSP. media-src blob: lets the browser read a
# selected video's length before upload.
# Both policies are enforced, so inline scripts run only with a matching hash.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' {{API_ORIGIN}} {{R2_ORIGIN}}; media-src 'self' blob: {{API_ORIGIN}}; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed build output.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidated so a new service worker or app manifest is picked up.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=86400
